// dRamp — Cross-Border Value Execution Marketplace
// Core economic engine schema.
//
// NOTE: This is a prototype. PostgreSQL is the datastore (Neon). All monetary
// values are stored as Decimal (native numeric type). Concurrency is enforced
// via Prisma interactive transactions with conditional re-checks inside the
// transaction. Blockchain / bank / PSP rails are simulated.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Users — authenticated marketplace participants
// ---------------------------------------------------------------------------
model User {
  id         String   @id @default(cuid())
  email      String   @unique
  name       String?
  password   String? // null for waitlist-only / demo-as-pending; set when an account is created
  role       String   @default("USER") // USER | PROVIDER_OPERATOR | ADMIN
  status     String   @default("ACTIVE") // ACTIVE | SUSPENDED
  isDemo     Boolean  @default(false)
  providerId String?  // for PROVIDER_OPERATORs: the LiquidityProvider they operate
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  intents       ExecutionIntent[]
  waitlistApproved WaitlistEntry[] @relation("WaitlistReviewer")
  operatedProvider LiquidityProvider? @relation("OperatedBy", fields: [providerId], references: [id])
}

// ---------------------------------------------------------------------------
// WaitlistEntry — sign-ups pending admin approval before an account is created
// ---------------------------------------------------------------------------
model WaitlistEntry {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  requestedRole String   @default("USER") // USER | PROVIDER_OPERATOR
  status        String   @default("PENDING") // PENDING | APPROVED | REJECTED
  note          String?
  createdAt     DateTime @default(now())
  reviewedAt    DateTime?
  reviewedById  String?
  reviewedBy    User?    @relation("WaitlistReviewer", fields: [reviewedById], references: [id])
  createdUserId String? // the User id created once approved

  @@index([status])
}

// ---------------------------------------------------------------------------
// 1. ExecutionIntent — what the user wants (stable, may outlive many attempts)
// ---------------------------------------------------------------------------
model ExecutionIntent {
  id                          String   @id @default(cuid())
  userId                      String
  user                        User     @relation(fields: [userId], references: [id])

  sourceAmount                Decimal
  sourceAsset                 String
  sourceCountry               String
  destinationAsset            String
  destinationCountry          String
  minimumDestinationAmount    Decimal?
  maximumTotalCost            Decimal?
  targetRate                  Decimal?

  riskTolerance               String // MAX_RELIABILITY | BALANCED | LOWEST_COST
  executionPolicy             String // NOW | WAIT_FOR_BETTER
  maxWaitSeconds              Int
  cancellationPolicy          String
  allowedSettlementAssets     String // JSON array of asset ids (empty = all eligible)
  prohibitedSettlementAssets  String // JSON array of asset ids

  status                      String // ACTIVE | COMPLETED | CANCELLED | EXPIRED | FAILED
  createdAt                   DateTime @default(now())
  expiresAt                   DateTime

  executions                  Execution[]
  auditEvents                 AuditEvent[]

  @@index([status])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// 2. Execution — a concrete attempt to fulfill an intent
// ---------------------------------------------------------------------------
model Execution {
  id                String   @id @default(cuid())
  intentId          String
  intent            ExecutionIntent @relation(fields: [intentId], references: [id])

  attemptNumber     Int
  status            String // canonical state machine
  commitmentStatus  String // REVERSIBLE | PARTIALLY_COMMITTED | IRREVERSIBLE
  selectedRouteId   String?
  referenceRouteId  String? // current best candidate while SEARCHING
  selectedRouteJson String? // snapshot of the selected route for the receipt
  startedAt         DateTime @default(now())
  completedAt       DateTime?
  failureReason     String?
  waitedSeconds     Int      @default(0)
  lastTickAt        DateTime @default(now())

  routes            Route[]
  obligations       Obligation[]
  legs              Leg[]
  reservations      Reservation[]
  collateralLocks   CollateralLock[]
  ledgerEntries     LedgerEntry[]
  auditEvents       AuditEvent[]
  disputes          Dispute[]

  @@index([intentId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// 3. Route — a candidate plan discovered by the routing engine
// ---------------------------------------------------------------------------
model Route {
  id              String   @id @default(cuid())
  executionId     String
  execution       Execution @relation(fields: [executionId], references: [id])

  legCount        Int
  totalCost       Decimal
  effectiveCost   Decimal
  grossOutput     Decimal
  netOutput       Decimal
  incentiveBps    Int

  // Separate risk dimensions (0..1)
  riskCounterparty     Float
  riskSettlementAsset  Float
  riskLiquidity        Float
  riskOperational      Float
  riskDuration         Float
  riskComposite        Float

  expectedExecutionSeconds Int
  explanation             String
  tag                     String   // BEST | CHEAPEST | FASTEST | SAFEST | CANDIDATE
  status                  String   // CANDIDATE | SELECTED | RESERVED | SUPERSEDED | EXPIRED | FAILED
  splitRoute              Boolean  @default(false)
  expiresAt               DateTime?
  createdAt               DateTime @default(now())

  legs            Leg[]

  @@index([executionId])
}

// ---------------------------------------------------------------------------
// 4. Leg — a single hop within a route (provider + offer + role)
// ---------------------------------------------------------------------------
model Leg {
  id                String   @id @default(cuid())
  routeId           String
  route             Route    @relation(fields: [routeId], references: [id])
  executionId       String?
  execution         Execution? @relation(fields: [executionId], references: [id])

  providerId        String
  provider          LiquidityProvider @relation(fields: [providerId], references: [id])
  offerId           String
  offer             LiquidityOffer @relation(fields: [offerId], references: [id])
  sequence          Int
  role              String   // SOURCE | SETTLEMENT_HOP | DESTINATION
  amount            Decimal
  sourceAsset       String
  destinationAsset  String
  settlementAssetId String?
  channelType       String   // AUTOMATIC | MANUAL
  status            String   // PENDING | RESERVED | IN_PROGRESS | CONFIRMED | FAILED | CANCELLED
  commitmentStatus  String   // REVERSIBLE | PARTIALLY_COMMITTED | IRREVERSIBLE
  actorId           String?  // for manual confirmations
  actorNote         String?
  confirmedAt       DateTime?

  @@index([routeId])
  @@index([executionId])
}

// ---------------------------------------------------------------------------
// 5. LiquidityProvider — any source of liquidity (not just "agents")
// ---------------------------------------------------------------------------
model LiquidityProvider {
  id              String   @id @default(cuid())
  name            String
  providerType    String   // LOCAL_FIAT_AGENT | PSP | BANK | STABLECOIN_LP | CEX | DEX | TREASURY | MARKET_MAKER | SETTLEMENT_ASSET_SPONSOR | HYBRID
  trustModel      String   // COLLATERALIZED | INSTITUTIONALLY_TRUSTED | PRE_FUNDED | EXTERNAL_ESCROW | NON_CUSTODIAL
  capabilities    String   // JSON array
  countries       String   // JSON array
  reputationScore Float
  status          String   // APPLIED | REVIEW | APPROVED | ACTIVE | SUSPENDED | REJECTED
  vaultId         String?
  createdAt       DateTime @default(now())

  // Onboarding profile (Prompt 2)
  jurisdiction      String?
  contactEmail      String?
  supportedAssets   String?  // JSON array of asset symbols
  settlementMethods String?  // JSON array
  apiIntegrationStatus String? // NONE | PENDING | CONNECTED | FAILED
  onboardingNote    String?
  reviewedById      String?
  reviewedAt        DateTime?

  // Prompt 3: derived tier + reputation
  tier              String   @default("NEW") // NEW | VERIFIED | TRUSTED | PREMIUM
  tierUpdatedAt     DateTime @default(now())

  offers          LiquidityOffer[]
  obligations     Obligation[]
  legs            Leg[]
  vault           Vault?
  operators       User[]    @relation("OperatedBy")
  apiKeys         ApiKey[]
  webhookEndpoints WebhookEndpoint[]
  incentiveCampaigns SettlementIncentiveCampaign[]
  disputes        Dispute[]
  performanceSnapshots ProviderPerformanceSnapshot[]
  commitments     LiquidityCommitment[]
  corridorScores  ProviderCorridorScore[]
  quoteWinLosses  QuoteWinLoss[]

  @@index([status])
  @@index([tier])
}

// ---------------------------------------------------------------------------
// 6. LiquidityOffer — a published capability with pricing & capacity
// ---------------------------------------------------------------------------
model LiquidityOffer {
  id                    String   @id @default(cuid())
  providerId            String
  provider              LiquidityProvider @relation(fields: [providerId], references: [id])

  capability            String   // FIAT_IN | FIAT_OUT | SETTLEMENT_IN | SETTLEMENT_OUT | SWAP | FX | BANK_TRANSFER | MOBILE_MONEY | CASH | CARD | ONCHAIN_TRANSFER | ONCHAIN_SWAP | CEX_EXECUTION | DEX_EXECUTION
  sourceAsset           String
  destinationAsset      String
  sourceCountry         String
  destinationCountry    String
  rate                  Decimal  // amount of destination asset per 1 unit of source asset
  feeBps                Int
  minimumAmount         Decimal
  maximumAmount         Decimal
  availableCapacity     Decimal  // current reservable capacity in source asset
  reservedCapacity      Decimal  @default(0)
  settlementAssetId     String?
  channelType           String   // AUTOMATIC | MANUAL
  expectedExecutionSeconds Int
  incentiveBps          Int      @default(0)
  active                Boolean  @default(true)
  expiresAt             DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  legs            Leg[]
  reservations    Reservation[]

  @@index([providerId])
  @@index([active])
}

// ---------------------------------------------------------------------------
// 7. SettlementAsset — stablecoins, volatile tokens, internal settlement units
// ---------------------------------------------------------------------------
model SettlementAsset {
  id                    String   @id @default(cuid())
  symbol                String   @unique
  issuer                String
  assetType             String   // STABLECOIN | VOLATILE_TOKEN | INTERNAL_SETTLEMENT_UNIT
  network               String
  volatilityScore       Float    // 0..1 (0 = stable)
  liquidityScore        Float    // 0..1 (1 = deep)
  pegQuality            Float?
  redemptionModel       String
  incentiveRate         Int      @default(0) // bps subsidy for usage
  incentiveSource       String?
  settlementHaircut     Float    @default(0) // haircut applied when used for settlement
  collateralHaircut     Float    @default(0) // haircut applied when used as collateral
  isEligibleCollateral  Boolean  @default(false) // HARD INVARIANT: false if assetType == VOLATILE_TOKEN
  maximumNetworkExposure Decimal?
  status                String   // ACTIVE | INELIGIBLE | DELISTED
  createdAt             DateTime @default(now())

  incentiveCampaigns   SettlementIncentiveCampaign[]
}

// ---------------------------------------------------------------------------
// 8. Vault — collateral store for COLLATERALIZED providers
// ---------------------------------------------------------------------------
model Vault {
  id                    String   @id @default(cuid())
  providerId            String   @unique
  provider              LiquidityProvider @relation(fields: [providerId], references: [id])

  holdingsJson          String   // JSON: { assetId: amount }
  usableCollateral      Decimal  // Σ market_value × (1 - collateral_haircut)
  lockedCollateral      Decimal  @default(0)
  collateralizationRatio Float   @default(1.5) // 150%
  maxExposure           Decimal

  collateralLocks       CollateralLock[]
  createdAt             DateTime @default(now())
}

// ---------------------------------------------------------------------------
// 9. Obligation — the fundamental economic promise created by execution
// ---------------------------------------------------------------------------
model Obligation {
  id                    String   @id @default(cuid())
  executionId           String
  execution             Execution @relation(fields: [executionId], references: [id])
  legId                 String?
  providerId            String
  provider              LiquidityProvider @relation(fields: [providerId], references: [id])
  counterpartyProviderId String?
  amount                Decimal
  asset                 String
  collateralBackingId   String?
  dueAt                 DateTime
  status                String   // CREATED | ACTIVE | FULFILLED | EXPIRED | FAILED | DISPUTED | SLASHED
  createdAt             DateTime @default(now())
  fulfilledAt           DateTime?

  @@index([executionId])
  @@index([providerId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// 10. Reservation — capacity hold on an offer (concurrency-safe)
// ---------------------------------------------------------------------------
model Reservation {
  id              String   @id @default(cuid())
  executionId     String
  execution       Execution @relation(fields: [executionId], references: [id])
  offerId         String
  offer           LiquidityOffer @relation(fields: [offerId], references: [id])
  amount          Decimal
  status          String   // ACTIVE | RELEASED | CONSUMED | EXPIRED
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  @@index([executionId])
  @@index([offerId])
}

// ---------------------------------------------------------------------------
// 11. CollateralLock — locked collateral backing an obligation
// ---------------------------------------------------------------------------
model CollateralLock {
  id              String   @id @default(cuid())
  vaultId         String
  vault           Vault    @relation(fields: [vaultId], references: [id])
  providerId      String
  executionId     String
  execution       Execution @relation(fields: [executionId], references: [id])
  obligationId    String?
  amount          Decimal
  asset           String
  status          String   // LOCKED | RELEASED | SLASHED
  createdAt       DateTime @default(now())

  @@index([executionId])
  @@index([vaultId])
}

// ---------------------------------------------------------------------------
// 12. LedgerEntry — double-entry internal ledger (immutable)
// ---------------------------------------------------------------------------
model LedgerEntry {
  id              String   @id @default(cuid())
  timestamp       DateTime @default(now())
  debitAccount    String
  creditAccount   String
  amount          Decimal
  asset           String
  entryType       String   // MINT | BURN | TRANSFER | LOCK | RELEASE | SLASH | FEE | INCENTIVE | COMPENSATION | REFUND
  executionId     String?
  execution       Execution? @relation(fields: [executionId], references: [id])
  obligationId    String?
  idempotencyKey  String   @unique
  description     String?

  @@index([executionId])
  @@index([debitAccount])
  @@index([creditAccount])
}

// ---------------------------------------------------------------------------
// 13. AuditEvent — immutable, hash-chained event stream
// ---------------------------------------------------------------------------
model AuditEvent {
  id              String   @id @default(cuid())
  timestamp       DateTime @default(now())
  executionId     String?
  execution       Execution? @relation(fields: [executionId], references: [id])
  intentId        String?
  intent          ExecutionIntent? @relation(fields: [intentId], references: [id])
  eventType       String
  payloadJson     String
  actorType       String   // SYSTEM | USER | PROVIDER
  actorId         String?
  prevHash        String
  hash            String

  @@index([executionId])
  @@index([intentId])
}

// ---------------------------------------------------------------------------
// 14. IdempotencyRecord — guards all financial mutations
// ---------------------------------------------------------------------------
model IdempotencyRecord {
  id              String   @id @default(cuid())
  key             String   @unique
  operation       String
  requestPayload  String
  responseStatus  Int
  responseBody    String?
  createdAt       DateTime @default(now())
}

// ---------------------------------------------------------------------------
// 15. MarketSignal — simulated market state (offers changing over time)
// ---------------------------------------------------------------------------
model MarketSignal {
  id              String   @id @default(cuid())
  kind            String   // NEW_LIQUIDITY | PRICE_CHANGE | CAPACITY_CHANGE | PROVIDER_JOIN | PROVIDER_LEAVE | ASSET_INELIGIBLE
  payloadJson     String
  triggerAt       DateTime
  fired           Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([fired, triggerAt])
}

// ===========================================================================
// PROMPT 2 — Open Liquidity Marketplace extensions
//
// These models extend the existing domain (never replace it). All economic
// effects still flow through the existing LedgerEntry, ExecutionIntent,
// Execution, Route, Leg, Obligation, CollateralLock, and AuditEvent entities.
// ===========================================================================

// ---------------------------------------------------------------------------
// P2-1. ApiKey — provider-scoped API credentials for the Open Liquidity API
// ---------------------------------------------------------------------------
model ApiKey {
  id            String   @id @default(cuid())
  providerId    String
  provider      LiquidityProvider @relation(fields: [providerId], references: [id])
  keyId         String   @unique // public identifier (e.g. "pk_live_xxxx")
  secretHash    String   // bcrypt hash of the secret; plaintext shown once on creation
  label         String   // human-readable name
  scopes        String   // JSON array: ["offers","executions","obligations","reconcile"]
  status        String   @default("ACTIVE") // ACTIVE | REVOKED
  lastUsedAt    DateTime?
  createdAt     DateTime @default(now())
  revokedAt     DateTime?

  @@index([providerId])
}

// ---------------------------------------------------------------------------
// P2-2. WebhookEndpoint — outbound webhook configuration per provider
// ---------------------------------------------------------------------------
model WebhookEndpoint {
  id            String   @id @default(cuid())
  providerId    String
  provider      LiquidityProvider @relation(fields: [providerId], references: [id])
  url           String
  encryptedSecret String // AES-256-GCM encrypted signing secret (never plaintext)
  encryptionKeyVersion Int @default(1) // key version for rotation
  events        String   // JSON array of event types to subscribe to
  status        String   @default("ACTIVE") // ACTIVE | PAUSED
  createdAt     DateTime @default(now())

  deliveries    WebhookDelivery[]

  @@index([providerId])
}

// ---------------------------------------------------------------------------
// P2-3. WebhookDelivery — retryable, idempotent outbound webhook deliveries
// ---------------------------------------------------------------------------
model WebhookDelivery {
  id            String   @id @default(cuid())
  endpointId    String
  endpoint      WebhookEndpoint @relation(fields: [endpointId], references: [id])
  eventType     String
  payloadJson   String
  signature     String   // HMAC-SHA256 of payload
  status        String   @default("PENDING") // PENDING | DELIVERED | FAILED | RETRYING
  attempts      Int      @default(0)
  responseStatus Int?
  responseBody  String?
  nextRetryAt   DateTime?
  createdAt     DateTime @default(now())
  deliveredAt   DateTime?

  @@index([endpointId, status])
  @@index([nextRetryAt])
}

// ---------------------------------------------------------------------------
// P2-4. SettlementIncentiveCampaign — sponsor-funded incentive programs
// ---------------------------------------------------------------------------
model SettlementIncentiveCampaign {
  id              String   @id @default(cuid())
  settlementAssetId String
  settlementAsset SettlementAsset @relation(fields: [settlementAssetId], references: [id])
  sponsorProviderId String?
  sponsorProvider  LiquidityProvider? @relation(fields: [sponsorProviderId], references: [id])
  name            String
  incentiveBps    Int      // bps subsidy applied to qualifying settlement volume
  fundingSource   String   // issuer | sponsor | dramp
  startDate       DateTime
  endDate         DateTime
  totalBudget     Decimal  // max total incentive payout (in settlement asset)
  perTxnCap       Decimal? // max incentive per single execution
  volumeCap       Decimal? // max qualifying settlement volume
  qualifiedVolume Decimal  @default(0) // cumulative qualifying settlement volume actually earned
  accrued         Decimal  @default(0) // earned by completed executions (not yet paid)
  paid            Decimal  @default(0) // actually credited
  eligibleCorridors String? // JSON array of "SRC:DST" corridors; null = all
  eligibleRiskLevels String? // JSON array; null = all
  eligibleProviderTypes String? // JSON array; null = all
  status          String   @default("ACTIVE") // DRAFT | ACTIVE | PAUSED | EXHAUSTED | EXPIRED
  createdAt       DateTime @default(now())

  earnings        IncentiveEarning[]

  @@index([settlementAssetId, status])
  @@index([status])
}

// ---------------------------------------------------------------------------
// P2-5. IncentiveEarning — tracks accrued incentive per completed execution
// ---------------------------------------------------------------------------
model IncentiveEarning {
  id              String   @id @default(cuid())
  campaignId      String
  campaign        SettlementIncentiveCampaign @relation(fields: [campaignId], references: [id])
  executionId     String
  providerId      String
  amount          Decimal
  qualifiedVolume Decimal  @default(0) // settlement volume that earned this incentive
  status          String   @default("ACCRUED") // ACCRUED | PAID | REVERSED
  createdAt       DateTime @default(now())
  paidAt          DateTime?

  // Concurrency safety: one earning per (campaign, execution, provider).
  // Prevents duplicate accrual if two concurrent completion processes race.
  @@unique([campaignId, executionId, providerId])
  @@index([campaignId])
  @@index([executionId])
}

// ---------------------------------------------------------------------------
// P2-6. Dispute — investigation workflow for execution/obligation failures
// ---------------------------------------------------------------------------
model Dispute {
  id              String   @id @default(cuid())
  executionId     String
  execution       Execution @relation(fields: [executionId], references: [id])
  obligationId    String?
  providerId      String
  provider        LiquidityProvider @relation(fields: [providerId], references: [id])
  reason          String
  description     String?
  status          String   @default("OPEN") // OPEN | INVESTIGATING | RESOLVED_PROVIDER | RESOLVED_USER | PARTIAL_COMPENSATION | SLASHED | CLOSED
  resolution      String?
  compensationAmount Decimal? @default(0)
  slashedAmount   Decimal? @default(0)
  openedById      String
  resolvedById    String?
  createdAt       DateTime @default(now())
  resolvedAt      DateTime?

  @@index([executionId])
  @@index([providerId, status])
  @@index([status])
}

// ---------------------------------------------------------------------------
// P2-7. ReconciliationItem — discrepancy detection + resolution workflow
// ---------------------------------------------------------------------------
model ReconciliationItem {
  id              String   @id @default(cuid())
  providerId      String
  type            String   // MISSING_SETTLEMENT | AMOUNT_MISMATCH | DUPLICATE_SETTLEMENT | STALE_OBLIGATION | BALANCE_DIFFERENCE
  severity        String   @default("MEDIUM") // LOW | MEDIUM | HIGH
  status          String   @default("DETECTED") // DETECTED | INVESTIGATING | MATCHED | ADJUSTED | RESOLVED
  executionId     String?
  obligationId    String?
  expectedAmount  Decimal?
  reportedAmount  Decimal?
  asset           String?
  description     String?
  resolution      String?
  resolvedById    String?
  createdAt       DateTime @default(now())
  resolvedAt      DateTime?

  @@index([providerId, status])
  @@index([status])
}

// ---------------------------------------------------------------------------
// P2-8. Notification — in-app notifications driven by domain events
// ---------------------------------------------------------------------------
model Notification {
  id              String   @id @default(cuid())
  userId          String
  type            String   // ROUTE_FOUND | BETTER_ROUTE | EXECUTION_STARTED | EXECUTION_COMPLETED | CANCELLED | DISPUTE | OBLIGATION | COLLATERAL_WARNING | OFFER_EXPIRING | PROVIDER_OBLIGATION
  title           String
  body            String?
  payloadJson     String?
  read            Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([userId, read])
  @@index([createdAt])
}

// ===========================================================================
// PROMPT 3 — Network Economics, Liquidity Competition & Reputation
//
// These models extend the existing domain to make dRamp economically
// intelligent. All economic effects still flow through the existing ledger.
// Reputation is derived from observable historical behavior — never opaque.
// ===========================================================================

// ---------------------------------------------------------------------------
// P3-1. ProviderPerformanceSnapshot — periodic metrics for time-weighted decay
// ---------------------------------------------------------------------------
model ProviderPerformanceSnapshot {
  id              String   @id @default(cuid())
  providerId      String
  provider        LiquidityProvider @relation(fields: [providerId], references: [id])
  periodStart     DateTime
  periodEnd       DateTime
  // Raw counts for this period
  requestsReceived Int    @default(0)
  executionsAccepted Int @default(0)
  executionsCompleted Int @default(0)
  executionsFailed Int   @default(0)
  executionsCancelled Int @default(0)
  disputes        Int      @default(0)
  slashes         Int      @default(0)
  // Aggregated values
  totalVolume     Decimal  @default(0)
  totalEarnings   Decimal  @default(0)
  totalIncentives Decimal  @default(0)
  avgExecutionSeconds Int  @default(0)
  // Liquidity metrics
  avgAvailableCapacity Decimal @default(0)
  avgReservedCapacity Decimal @default(0)
  peakUtilization Float   @default(0)
  // Computed reputation components (stored for history/decay)
  reliabilityScore    Float @default(0.5)
  speedScore          Float @default(0.5)
  liquidityScore      Float @default(0.5)
  pricingScore        Float @default(0.5)
  disputeScore        Float @default(0.5)
  operationalScore    Float @default(0.5)
  overallReputation   Float @default(0.5)
  createdAt       DateTime @default(now())

  @@index([providerId, periodEnd])
}

// ---------------------------------------------------------------------------
// P3-2. LiquidityCommitment — provider promises to maintain service levels
// ---------------------------------------------------------------------------
model LiquidityCommitment {
  id              String   @id @default(cuid())
  providerId      String
  provider        LiquidityProvider @relation(fields: [providerId], references: [id])
  sourceAsset     String
  destinationAsset String
  sourceCountry   String
  destinationCountry String
  minimumLiquidity Decimal
  maximumLiquidity Decimal?
  targetExecutionSeconds Int
  operatingHoursStart Int?  // hour 0-23
  operatingHoursEnd Int?
  startDate       DateTime
  endDate         DateTime
  status          String   @default("ACTIVE") // ACTIVE | PAUSED | EXPIRED | BREACHED
  // Reliability tracking
  samples         Int      @default(0)
  samplesMet      Int      @default(0)
  avgAvailable    Decimal  @default(0)
  reliabilityPct  Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([providerId, status])
  @@index([sourceAsset, destinationAsset])
}

// ---------------------------------------------------------------------------
// P3-3. ProviderCorridorScore — per-provider-per-corridor performance
// ---------------------------------------------------------------------------
model ProviderCorridorScore {
  id              String   @id @default(cuid())
  providerId      String
  provider        LiquidityProvider @relation(fields: [providerId], references: [id])
  sourceAsset     String
  destinationAsset String
  sourceCountry   String
  destinationCountry String
  // Rolling metrics for this specific corridor
  executions      Int      @default(0)
  completed       Int      @default(0)
  failed          Int      @default(0)
  avgExecutionSeconds Int  @default(0)
  totalVolume     Decimal  @default(0)
  completionRate  Float    @default(0)
  avgFeeBps       Float    @default(0)
  lastExecutedAt  DateTime?
  score           Float    @default(0.5) // 0..1, corridor-specific reputation
  updatedAt       DateTime @updatedAt

  @@unique([providerId, sourceAsset, destinationAsset, sourceCountry, destinationCountry])
  @@index([sourceAsset, destinationAsset])
}

// ---------------------------------------------------------------------------
// P3-4. QuoteWinLoss — tracks why offers won/lost for competitive feedback
// ---------------------------------------------------------------------------
model QuoteWinLoss {
  id              String   @id @default(cuid())
  providerId      String
  provider        LiquidityProvider @relation(fields: [providerId], references: [id])
  executionId     String
  offerId         String?
  corridor        String   // "SRC:DST"
  result          String   // WON | LOST | EXPIRED
  rank            Int?     // rank among candidates
  winnerProviderId String?
  winnerFeeBps    Int?
  winnerExecutionSeconds Int?
  ourFeeBps       Int?
  ourExecutionSeconds Int?
  reasonLost      String?  // "higher_cost" | "slower" | "higher_risk" | "manual_channel" | "lower_reputation"
  createdAt       DateTime @default(now())

  @@index([providerId, createdAt])
  @@index([executionId])
}

// ---------------------------------------------------------------------------
// P3-5. NetworkFeeConfig — configurable protocol fee framework
// ---------------------------------------------------------------------------
model NetworkFeeConfig {
  id              String   @id @default(cuid())
  name            String
  // Fee in bps; can be scoped
  feeBps          Int
  // Scope: GLOBAL | CORRIDOR | PROVIDER_TYPE | SETTLEMENT_ASSET
  scopeType       String   @default("GLOBAL")
  scopeKey        String?  // e.g. "USD:EUR" for corridor, "BANK" for provider type
  // Volume tiers (optional)
  minVolume       Decimal?
  maxVolume       Decimal?
  // Rebate (negative fee) for valuable behavior
  rebateBps       Int      @default(0)
  rebateReason    String?  // "high_reliability" | "committed_liquidity" | "difficult_corridor"
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())

  @@index([scopeType, scopeKey, status])
}

